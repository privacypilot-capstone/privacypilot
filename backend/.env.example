# Copy to backend/.env (git-ignored) and fill in. Every setting is optional.
# Variables set by docker compose for the containers take precedence over this file.

# LLM executive summary and chat (either one)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Only needed when the API or a worker runs on the host (outside Docker).
# The API and the worker MUST use the same database; /health checks this.
# Docker Postgres from the host: port 5432, or the port your local override maps.
# DATABASE_URL=postgresql://pilot:pilot@localhost:5432/privacypilot
# REDIS_URL=redis://localhost:6379/0

# Extra allowed frontend origins (localhost on any port is always allowed)
# CORS_ORIGINS=https://privacypilot.example.org
